# ============================================================================
# Environmental Intelligence Pipeline - Environment Variables Template
# ============================================================================

# OpenAQ API Configuration
OPENAQ_API_KEY=your_openaq_api_key_here
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# Database Configuration (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=data_engineering
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka Real-Time Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_URL=redis://redis:6379/0
OPENAQ_POLL_INTERVAL=30
USGS_POLL_INTERVAL=30
KAFKA_RETRIES=3
REDIS_MAX_ITEMS=100

# Prefect Server Orchestration Configuration
PREFECT_API_URL=http://prefect-server:4200/api
